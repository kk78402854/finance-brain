# ===================== mineru api以及url处理地址 =====================
# 金融项目 PDF（季报/基金概要/风险揭示书等）通过 MinerU 云端 API 解析为 Markdown
MINERU_API_TOKEN=your_mineru_api_token
MINERU_BASE_URL=https://mineru.net/api/v4

# ===================== 文本和视觉模型配置 =====================
# api_key申请地址：https://bailian.console.aliyun.com/cn-beijing/?tab=model#/api-key
# Qwen3系列Flash模型，复杂推理类任务性能优秀，支持1M上下文长度
LLM_DEFAULT_MODEL=qwen-flash
VL_MODEL=qwen-vl-plus
OPENAI_API_KEY=your_dashscope_api_key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_TEMPERATURE=0.1

# ===================== minio客户端配置 =====================
# 金融 PDF 中的图表经 MinerU 提取后上传 MinIO，供前端展示
MINIO_ENDPOINT=192.168.10.8:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
#是否使用 HTTPS/TLS 加密连接 False:HTTP明文连接    True:HTTPS TLS 加密连接
MINIO_SECURE=False

# ===================== embedding模型客户端配置 =====================
# BGE-M3模型本地缓存/部署路径（本地加载模型时使用，指向ModelScope下载的模型目录）
BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
# BGE-M3模型官方标识（ModelScope/HuggingFace通用，拉取模型时使用）
BGE_M3=BAAI/bge-m3
# BGE-M3运行设备，cuda:0表示使用第1块GPU，cpu表示使用CPU，cuda:N表示第N+1块GPU
#BGE_DEVICE=cuda:0
BGE_DEVICE=cpu
# BGE-M3是否开启FP16半精度推理，1=开启（GPU加速更高效），0=关闭（兼容低版本GPU/CPU）
BGE_FP16=0

# ===================== Milvus模型客户端配置 =====================
# 切换成你milvus的url地址
MILVUS_URL=http://192.168.10.8:19530
# 存储金融内容切片集合（金融项目）
CHUNKS_COLLECTION=finance_chunks
# 存储每份文档对应的主实体名集合（金融项目：产品名/机构名/公司名等，替代原 item_name）
ITEM_NAME_COLLECTION=finance_product_names
# 预留
ENTITY_NAME_COLLECTION=finance_entities

# ===================== Mongodb的配置 =====================
MONGO_URL=mongodb://192.168.10.8:27017
MONGO_DB_NAME=finance_kb

# ===================== mcp的配置（联网搜索，金融可选）=====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
# ===================== 重排序模型配置 =====================
BGE_RERANKER_LARGE=D:/ai_models/modelscope_cache/models/rerank/models/BAAI--bge-reranker-large/snapshots/master
#BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_DEVICE=cpu
#BGE_RERANKER_FP16=1
BGE_RERANKER_FP16=0

# ===================== 日志配置 =====================
# 控制台日志：True=开启/False=关闭，级别可选(DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO

# 文件日志：True=开启/False=关闭，级别与控制台可独立设置
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
# 日志文件保留天数（自动删除过期日志，避免磁盘占满）
LOG_FILE_RETENTION=7 days
